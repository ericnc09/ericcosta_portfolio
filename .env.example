# Ask AI chat: free-tier provider keys. Any subset works; a provider without a
# key is skipped. Local dev: copy to .env.local. Production (Cloudflare Worker):
#   npx wrangler secret put GROQ_API_KEY   (and so on)
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Optional: reorder or disable providers, and override model ids.
# ASK_PROVIDER_ORDER=groq,gemini,cerebras,openrouter
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
# CEREBRAS_MODEL=gpt-oss-120b
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
